+/* --- RA80 debug: arbitrary switch register access via debugfs ---
+ * echo "r ADDR"        > /sys/kernel/debug/yt921x/reg
+ * echo "w ADDR VALUE"  > /sys/kernel/debug/yt921x/reg
+ * echo "d ADDR COUNT"  > /sys/kernel/debug/yt921x/reg
+ * Results go to the kernel log (DBGR/DBGW lines).
+ */
+static struct dentry *yt921x_dbg_root;
+static struct yt921x_priv *yt921x_dbg_priv;
+
+static ssize_t yt921x_dbg_reg_write(struct file *file,
+				    const char __user *ubuf,
+				    size_t count, loff_t *ppos)
+{
+	struct yt921x_priv *priv = yt921x_dbg_priv;
+	char buf[64];
+	unsigned int addr, val = 0, cnt = 1;
+	char op;
+	int ret;
+
+	if (!priv)
+		return -ENODEV;
+	if (count >= sizeof(buf))
+		return -EINVAL;
+	if (copy_from_user(buf, ubuf, count))
+		return -EFAULT;
+	buf[count] = 0;
+	if (sscanf(buf, "%c %x %x", &op, &addr, &val) < 2)
+		return -EINVAL;
+	if (op == 'd')
+		cnt = val;
+
+	mutex_lock(&priv->reg_lock);
+	switch (op) {
+	case 'r':
+		ret = yt921x_reg_read(priv, addr, &val);
+		mutex_unlock(&priv->reg_lock);
+		if (ret)
+			dev_info(priv->ds.dev, "DBGR %x err %d\n", addr, ret);
+		else
+			dev_info(priv->ds.dev, "DBGR %x = %08x\n", addr, val);
+		break;
+	case 'd':
+		for (unsigned int i = 0; i < cnt && i < 1024; i++) {
+			u32 v;
+
+			ret = yt921x_reg_read(priv, addr + 4 * i, &v);
+			if (ret)
+				dev_info(priv->ds.dev, "DBGR %x err %d\n",
+					 addr + 4 * i, ret);
+			else
+				dev_info(priv->ds.dev, "DBGR %x = %08x\n",
+					 addr + 4 * i, v);
+		}
+		mutex_unlock(&priv->reg_lock);
+		ret = 0;
+		break;
+	case 'w':
+		ret = yt921x_reg_write(priv, addr, val);
+		mutex_unlock(&priv->reg_lock);
+		if (ret)
+			dev_info(priv->ds.dev, "DBGW %x err %d\n", addr, ret);
+		else
+			dev_info(priv->ds.dev, "DBGW %x <= %08x\n", addr, val);
+		break;
+	default:
+		mutex_unlock(&priv->reg_lock);
+		return -EINVAL;
+	}
+
+	return ret ? ret : count;
+}
+
+static const struct file_operations yt921x_dbg_reg_fops = {
+	.owner = THIS_MODULE,
+	.open = simple_open,
+	.write = yt921x_dbg_reg_write,
+};
