+static void yt921x_debug_dump(struct yt921x_priv *priv)
+{
+	struct device *dev = to_device(priv);
+	static const struct { const char *n; u32 r; } regs[] = {
+		{ "EXT_CPU_PORT", 0x8000c },
+		{ "CPU_TAG_TPID", 0x80010 },
+		{ "SERDES_CTRL", 0x80028 },
+		{ "IO_LEVEL", 0x80030 },
+		{ "SERDES0", 0x8008c },
+		{ "SERDES1", 0x80090 },
+		{ "CPU_COPY", 0x180690 },
+		{ "ACT_UNK_UCAST", 0x180734 },
+		{ "ACT_UNK_MCAST", 0x180738 },
+		{ "FILTER_UNK_UCAST", 0x180508 },
+		{ "FILTER_UNK_MCAST", 0x18050c },
+		{ "REG_80014", 0x80014 },
+		{ "REG_80018", 0x80018 },
+		{ "REG_8002c", 0x8002c },
+		{ "REG_80038", 0x80038 },
+		{ "REG_80040", 0x80040 },
+		{ "REG_80044", 0x80044 },
+		{ "REG_80358", 0x80358 },
+		{ "REG_8035c", 0x8035c },
+		{ "REG_80388", 0x80388 },
+		{ "REG_80394", 0x80394 },
+		{ "REG_80400", 0x80400 },
+		{ "REG_80408", 0x80408 },
+	};
+	u32 v;
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(regs); i++)
+		if (!yt921x_reg_read(priv, regs[i].r, &v))
+			dev_info(dev, "DBG %s[%x]=%08x\n", regs[i].n, regs[i].r, v);
+
+	for (u32 r = 0x80000; r < 0x80100; r += 4) {
+		u32 x;
+
+		if (!yt921x_reg_read(priv, r, &x))
+			dev_info(dev, "DBG R%05x=%08x\n", r, x);
+	}
+
+	for (i = 0; i < YT921X_PORT_NUM; i++) {
+		u32 a, b, c, d, e;
+
+		if (yt921x_reg_read(priv, 0x80100 + 4 * i, &a) ||
+		    yt921x_reg_read(priv, 0x80200 + 4 * i, &b) ||
+		    yt921x_reg_read(priv, 0x180294 + 4 * i, &c) ||
+		    yt921x_reg_read(priv, 0x1803d0 + 4 * i, &d) ||
+		    yt921x_reg_read(priv, 0x230010 + 4 * i, &e))
+			continue;
+		dev_info(dev, "DBG port%d ctl=%08x sts=%08x iso=%08x learn=%08x vlan=%08x\n",
+			 i, a, b, c, d, e);
+	}
+}
